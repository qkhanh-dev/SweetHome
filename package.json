{
  "name": "sweethome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:backend": "npm run build --workspace=@sweethome/backend",
    "start:backend": "npm run start --workspace=@sweethome/backend",
    "start:backend:dev": "npm run start:dev --workspace=@sweethome/backend",
    "test:backend": "npm run test --workspace=@sweethome/backend",
    "lint:backend": "npm run lint --workspace=@sweethome/backend"
  }
}
