# ==============================================================================
# SWEETHOME MONOREPO - ENVIRONMENT VARIABLES EXAMPLE (.env.example)
# Copy file này thành .env (ở thư mục gốc, backend/.env và frontend/.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16 - SH-02, SH-03, SH-21)
# ------------------------------------------------------------------------------
POSTGRES_USER=sweethome_user
POSTGRES_PASSWORD=sweethome_secret_2026
POSTGRES_DB=sweethome_db
POSTGRES_PORT=5432

# Prisma Database Connection URL
DATABASE_URL="postgresql://sweethome_user:sweethome_secret_2026@localhost:5432/sweethome_db?schema=public"

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (NestJS Modular Monolith - SH-04, SH-07, SH-08, SH-15, SH-16)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api

# JWT Authentication & RBAC Security (SH-07)
JWT_SECRET="sweethome_super_secret_jwt_key_2026_v2_ooad"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# Core Business Rules Constants (docs/BUSINESS_RULES.md - SH-01, SH-08)
DEPOSIT_RATE=0.3
REFUND_FULL_HOURS=72
REFUND_HALF_HOURS=24

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:3000"

# Payment Gateway Mock / VietQR Configuration (SD01, SD02 - SH-08)
# mock only works outside production; use live for real refunds.
PAYMENT_GATEWAY_MODE=mock
PAYMENT_REFUND_URL=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET="sweethome_webhook_secret_2026"
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="0987654321"
VIETQR_ACCOUNT_NAME="HOMESTAY SWEETHOME"

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (Next.js App Router - SH-05, SH-09, SH-10, SH-17, SH-18)
# ------------------------------------------------------------------------------
# URL kết nối tới NestJS Backend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Chế độ Mock Data Adapter (SH-05):
# - Đặt "true" ở Tầng 2–6 (SH-05, SH-09, SH-10, SH-17, SH-18) để FE chạy độc lập theo API_CONTRACT_v1.md
# - Đặt "false" ở Tầng 7–8 (SH-24, SH-25, SH-27) khi tích hợp nối API Backend thật
NEXT_PUBLIC_USE_MOCK=true
